{
  "name": "research-article",
  "sourceRepository": "https://github.com/al-org-dev/al-folio-distill",
  "sourceRevision": "c63daebbd1448a1c0ffa5fd8241ccf6161f775fa",
  "license": "MIT",
  "files": [
    {
      "path": "templates/distill/render.liquid",
      "content": "<!doctype html>\n<html>\n  <head>\n    {% include head.liquid %}\n    <link rel=\"stylesheet\" href=\"{{ '/assets/css/al-folio-distill.css' | relative_url | bust_file_cache }}\">\n\n    <!-- Distill js (vendored + integrity-pinned; see assets/js/distillpub/provenance.json) -->\n    {% al_folio_distill_runtime_scripts %}\n    {% if page._styles %}\n      <!-- Page/Post style -->\n      <style type=\"text/css\">\n        {{ page._styles }}\n      </style>\n    {% endif %}\n  </head>\n\n  <d-front-matter>\n    <script async type=\"text/json\">\n      {\n            \"title\": \"{{ page.title }}\",\n            \"description\": \"{{ page.description }}\",\n            \"published\": \"{{ page.date | date: '%B %d, %Y' }}\",\n            \"authors\": [\n              {% for author in page.authors %}\n              {\n                \"author\": \"{{ author.name }}\",\n                \"authorURL\": \"{{ author.url }}\",\n                \"affiliations\": [\n                  {\n                    \"name\": \"{{ author.affiliations.name }}\",\n                    \"url\": \"{{ author.affiliations.url }}\"\n                  }\n                ]\n              }{% if forloop.last == false %},{% endif %}\n              {% endfor %}\n            ],\n            \"katex\": {\n              \"delimiters\": [\n                {\n                  \"left\": \"$\",\n                  \"right\": \"$\",\n                  \"display\": false\n                },\n                {\n                  \"left\": \"$$\",\n                  \"right\": \"$$\",\n                  \"display\": true\n                }\n              ]\n            }\n          }\n    </script>\n  </d-front-matter>\n\n  <body class=\"{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}\">\n    <!-- Header -->\n    {% include header.liquid %}\n\n    <!-- Content -->\n    <div class=\"post distill\">\n      <d-title>\n        <h1>{{ page.title }}</h1>\n        <p>{{ page.description }}</p>\n      </d-title>\n      {% if page.authors %}\n        <d-byline></d-byline>\n      {% endif %}\n\n      <d-article>\n        {% if page.toc and page.toc.size > 0 %}\n          <d-contents>\n            <nav class=\"l-text figcaption\">\n              <h3>Contents</h3>\n              {% for section in page.toc %}\n                <div>\n                  <a href=\"#{{ section.name | slugify }}\">{{ section.name }}</a>\n                </div>\n                {% if section.subsections %}\n                  <ul>\n                    {% for subsection in section.subsections %}\n                      <li>\n                        <a href=\"#{{ subsection.name | slugify }}\">{{ subsection.name }}</a>\n                      </li>\n                    {% endfor %}\n                  </ul>\n                {% endif %}\n              {% endfor %}\n            </nav>\n          </d-contents>\n\n        {% elsif page.toc == true %}\n          <d-contents>\n            <nav class=\"l-text figcaption\">\n              <h3>Contents</h3>\n              {% toc %}\n            </nav>\n          </d-contents>\n        {% endif %}\n\n        {{ content }}\n      </d-article>\n\n      <d-appendix>\n        <d-footnote-list></d-footnote-list>\n        <d-citation-list></d-citation-list>\n      </d-appendix>\n\n      <d-bibliography src=\"{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}\"></d-bibliography>\n\n      <d-article>\n        {% if site.related_blog_posts and site.related_blog_posts.enabled %}\n          {% if page.related_posts == null or page.related_posts %}\n            {% include related_posts.liquid %}\n          {% endif %}\n        {% endif %}\n        <br>\n        <br>\n        {% if site.plugins contains 'al_comments' %}\n          {% include plugins/al_comments.liquid %}\n        {% endif %}\n      </d-article>\n    </div>\n\n    <!-- Footer -->\n    {% include footer.liquid %}\n\n    <!-- JavaScripts -->\n    {% include distill/scripts.liquid %}\n  </body>\n</html>\n"
    }
  ]
}
