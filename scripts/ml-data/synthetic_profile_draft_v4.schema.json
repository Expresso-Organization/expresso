{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expresso.local/schemas/synthetic-profile-draft-v4.json",
  "title": "Expresso synthetic profile draft v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "profileSeed", "persona", "records"],
  "properties": {
    "status": {"const": "generated"},
    "profileSeed": {"type": "string", "minLength": 1},
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRoles", "experienceYears", "primaryGoal"],
      "properties": {
        "targetRoles": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
        "experienceYears": {"type": "integer", "minimum": 0, "maximum": 40},
        "primaryGoal": {"type": "string", "enum": ["explore", "build", "organize"]}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draftId", "eventId", "categoryKey", "title", "properties", "bodyMd"],
        "properties": {
          "draftId": {"type": "string", "pattern": "^r(?:[1-9]|1[0-9]|20)$"},
          "eventId": {"type": "string", "pattern": "^ev(?:[1-9]|1[0-9]|20)$"},
          "categoryKey": {
            "type": "string",
            "enum": ["experience", "project", "education_history", "certification_award", "academic_writing", "activity_leadership", "skill_tool"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 100},
          "properties": {"type": "object", "maxProperties": 2},
          "bodyMd": {"type": "string", "minLength": 40, "maxLength": 450}
        }
      }
    }
  }
}
