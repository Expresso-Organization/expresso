{
  "name": "@expresso/dev-portal-status",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "pnpm install",
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('../../../docs/status/assets',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -b && tsc -p tsconfig.scanner.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.scanner.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "scan": "node scanner/main.ts",
    "test": "node --test scanner/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
