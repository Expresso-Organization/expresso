# 서버(Oracle) 배포용 환경. `.env`로 복사해 값을 채운다.
#
# 로컬(.env.example)과 다른 것만 주석을 단다.

NODE_ENV=production
# nginx가 앞단이라 바깥에 직접 열지 않는다.
HOST=127.0.0.1
PORT=4500
LOG_LEVEL=info

DATABASE_URL=postgres://expresso:CHANGE_ME@127.0.0.1:55432/expresso
REDIS_URL=redis://127.0.0.1:56379

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
QUEUE_PREFIX=expresso

# 배포 자산의 서명 키. 서버마다 다른 값이어야 하고, 바뀌면 이미 나간 링크가 끊긴다.
#   openssl rand -hex 32
ASSET_SIGNING_SECRET=CHANGE_ME

# 방문자 식별을 되돌릴 수 없게 만드는 소금. 바뀌면 이전 방문자와 이어지지 않는다.
#   openssl rand -hex 32
ANALYTICS_VISITOR_SALT=CHANGE_ME

# 올린 이미지가 저장될 곳. 디스크가 빠듯한 기계라 남은 용량을 보고 정한다.
MEDIA_PROVIDER=local
MEDIA_DIR=/home/ubuntu/expresso-media

# AI 프로바이더.
#
# 로그인된 CLI를 spawn한다. systemd는 셸을 거치지 않으므로 경로를 명시한다 —
# nvm이 깐 바이너리는 로그인 셸 PATH에만 있고 systemd에는 없다.
#
# 꺼 두면(`off`) 요건 추출과 문장 생성이 `EXTRACTOR_UNAVAILABLE` ·
# `WRITER_UNAVAILABLE`로 **멈춘다**(규칙으로 흉내 내지 않는다).
AI_PROVIDER=codex
CODEX_CLI_PATH=/home/ubuntu/.nvm/versions/node/v24.13.1/bin/codex

# 우리 호출 전용 codex 홈. `scripts/operations/prepare-codex-home.sh`로 만든다.
#
# 비우면 사람이 쓰는 `~/.codex`를 그대로 쓰는데, 그러면 그 사람의 `AGENTS.md`가
# **매 호출 컨텍스트에 실린다.** 이 기계 실측으로 호출당 4,260토큰이었다.
# 값보다 재현성이 문제다 — 그 파일을 고치면 우리 추출 결과가 조용히 달라진다.
CODEX_HOME=/home/ubuntu/.codex-expresso

# 본문 읽기 모델. 163건을 한 번에 도는 자리라 여기만 따로 정한다.
# 10건 표본에서 terra와 산출물이 전부 같았다(2026-08-13).
AI_MODEL_JOB_FACTS=gpt-5.6-luna
# CLAUDE_CLI_PATH=/home/ubuntu/.local/bin/claude

# 계약 한 번의 상한. 어댑터 기본값은 180초인데, 이 기계에서 opus 호출이 그걸
# 넘겨 **1차 시도가 통째로 버려지고 2차에서 성공했다**(2026-08-13 실측).
# 재시도로 덮으면 사용자는 3분을 더 기다리고 우리는 호출을 두 번 낸다.
AI_TIMEOUT_MS=600000

# 공공 API 키가 있으면 워크넷 공고가 수집에 들어온다. 없으면 어댑터를 만들지 않는다.
# WORK24_API_KEY=

# ── Google 로그인 ──
#
# 웹과 **같은** 클라이언트 ID를 넣는다. 백엔드는 이 값을 ID 토큰의 `aud`와
# 비교하는 데만 쓴다 — 비밀이 아니다. 인가 코드 교환(client secret)은 웹이 한다.
#
# 비우면 `/v1/auth/google*`이 503으로 답한다. 검증기 없이 통과하는 경로는 없다.
GOOGLE_CLIENT_ID=
