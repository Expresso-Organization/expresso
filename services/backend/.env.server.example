# 서버(Oracle) 배포용 환경. `.env`로 복사해 값을 채운다.
#
# 로컬(.env.example)과 다른 것만 주석을 단다.

NODE_ENV=production
# nginx가 앞단이라 바깥에 직접 열지 않는다.
HOST=127.0.0.1
PORT=4500
LOG_LEVEL=info

DATABASE_URL=postgres://expresso:CHANGE_ME@127.0.0.1:55432/expresso
REDIS_URL=redis://127.0.0.1:56379

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
QUEUE_PREFIX=expresso

# 배포 자산의 서명 키. 서버마다 다른 값이어야 하고, 바뀌면 이미 나간 링크가 끊긴다.
#   openssl rand -hex 32
ASSET_SIGNING_SECRET=CHANGE_ME

# 방문자 식별을 되돌릴 수 없게 만드는 소금. 바뀌면 이전 방문자와 이어지지 않는다.
#   openssl rand -hex 32
ANALYTICS_VISITOR_SALT=CHANGE_ME

# 올린 이미지가 저장될 곳. 디스크가 빠듯한 기계라 남은 용량을 보고 정한다.
MEDIA_PROVIDER=local
MEDIA_DIR=/home/ubuntu/expresso-media

# AI 프로바이더.
#
# `claude-code`·`codex`는 **로그인된 CLI를 spawn한다.** 서버의 두 CLI는 지금
# OAuth가 만료돼 있어(2026-08-13 확인) 그대로는 돌지 않는다. 둘 중 하나다 —
# 서버에서 CLI에 다시 로그인하거나, API 어댑터(`anthropic`)를 채우거나.
#
# 켜기 전까지 요건 추출과 문장 생성은 `EXTRACTOR_UNAVAILABLE` ·
# `WRITER_UNAVAILABLE`로 **멈춘다**(규칙으로 흉내 내지 않는다).
AI_PROVIDER=off
# CLI 경로를 쓸 때만. 서버의 claude는 로그인 셸 PATH에 없다.
# CLAUDE_CLI_PATH=/home/ubuntu/.local/bin/claude
# CODEX_CLI_PATH=

# 공공 API 키가 있으면 워크넷 공고가 수집에 들어온다. 없으면 어댑터를 만들지 않는다.
# WORK24_API_KEY=
