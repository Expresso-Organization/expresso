NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
MONGODB_URL=mongodb://expresso_runtime:change-me@127.0.0.1:57017/expresso?authSource=expresso&replicaSet=rs0
MONGODB_DATABASE=expresso
# 스키마 적용은 runtime 계정과 분리한 migration 계정으로 pnpm db:migrate에서만 사용합니다.
MONGODB_MIGRATE_URL=mongodb://expresso_migration:change-me@127.0.0.1:57017/expresso?authSource=expresso&replicaSet=rs0
REDIS_URL=redis://127.0.0.1:56379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
QUEUE_PREFIX=expresso-mongo-v1
CAREER_SOCKET_ALLOWED_ORIGIN=http://127.0.0.1:3000
# Playwright/E2E에서만 true. production은 runtime config가 거절한다.
CAREER_AI_DETERMINISTIC_TEST=false
# false면 Worker가 예약 실행을 새로 만들지 않는다. 격리 E2E·복구 점검에서만 사용한다.
SCHEDULED_JOBS_ENABLED=true

# ── AI ────────────────────────────────────────────────────────────────
# off        키도 로그인도 없이 돈다. 각 모듈의 규칙 기반 구현이 쓰인다 (기본)
# claude-code 이 머신에 로그인된 Claude Code로 부른다 — 개발 전용
# codex      이 머신에 로그인된 Codex CLI로 부른다 — 개발 전용
# fixture    녹화된 응답을 재생한다 — CI에서 쓴다
# anthropic  API 키로 부른다 — 운영 (ANTHROPIC_API_KEY 필요)
AI_PROVIDER=off
PAGE_GENERATION_FORMAT=json-render
AI_TIMEOUT_MS=180000
AI_FIXTURE_DIR=fixtures/ai
# 개발 중 호출을 픽스처로 남긴다. 그게 그대로 CI의 회귀 테스트가 된다.
AI_RECORD=false
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex

# 검색 해석만 API로 — 사람이 기다리는 자리라 새 질의마다 CLI를 띄우는 3.6초+를 뺀다.
# AI_PROVIDER가 off면 무시된다. anthropic을 쓰면 키가 없을 때 서버가 뜨지 않는다.
AI_PROVIDER_SEARCH_INTERPRET=anthropic
ANTHROPIC_API_KEY=

# 계약별 모델 덮어쓰기. 비우면 티어 기본값
# (job_analysis · recipe_draft = opus / search_interpret · insight_note = haiku / 나머지 sonnet)
# AI_MODEL_JOB_ANALYSIS=sonnet

# 올린 이미지를 어디에 두는가.
# local  이 머신의 디스크 — 개발과 단일 서버 배포
# s3     객체 저장소 (아직 미구현 — 여러 대로 늘리기 전에 채운다)
MEDIA_PROVIDER=local
MEDIA_DIR=var/media

# ── 메일 ──
#
# off     보내지 않는다. 수신자 · 제목 · 본문을 info 로그로 남긴다 — 개발 · CI (기본).
#         재설정 · 인증 링크는 이 로그에서 복사해 연다.
# resend  Resend HTTP API로 보낸다 — 운영. RESEND_API_KEY 가 있어야 뜬다.
#         발신 도메인(expresso.kr)의 SPF · DKIM 레코드가 Resend에서 인증돼 있어야 한다.
MAIL_PROVIDER=off
RESEND_API_KEY=
MAIL_FROM=Expresso <noreply@expresso.kr>
MAIL_TIMEOUT_MS=10000
# 메일 안의 링크가 가리키는 웹 주소. 웹의 APP_BASE_URL 과 같은 값.
APP_BASE_URL=http://localhost:3000

# ── Google 로그인 ──
#
# 웹과 **같은** 클라이언트 ID를 넣는다. 백엔드는 이 값을 ID 토큰의 `aud`와
# 비교하는 데만 쓴다 — 비밀이 아니다. 인가 코드 교환(client secret)은 웹이 한다.
#
# 비우면 `/v1/auth/google*`이 503으로 답한다. 검증기 없이 통과하는 경로는 없다.
GOOGLE_CLIENT_ID=

# 공통 에이전트 채팅. Claude 로그인 또는 ANTHROPIC_API_KEY 설정이 필요합니다.
AGENT_CHAT_ENABLED=0
# 모델은 Sonnet으로 고정합니다.
AGENT_CHAT_MODEL=sonnet
# 서버 인증을 사용할 개발 멤버의 기존 계정 ID(쉼표 구분). 비어 있으면 모두 개인 키가 필요합니다.
AGENT_CHAT_DEVELOPER_USER_IDS=

# 개인 API 키 저장용 AES-256 키. 운영에서 생성한 64자리 hex를 DB와 분리해 보관/백업합니다.
# AGENT_CREDENTIAL_ENCRYPTION_KEY=
