{
  "name": "@expresso/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker/main.ts",
    "build": "pnpm --filter @expresso/portfolio-renderer build && tsc -p tsconfig.build.json",
    "start": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "admin": "node --env-file-if-exists=.env dist/cli/admin.js",
    "typecheck": "pnpm --filter @expresso/portfolio-renderer build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@expresso/backend^...\" build && vitest run",
    "test:infra": "pnpm --filter \"@expresso/backend^...\" build && vitest run integration.test.ts",
    "test:load": "pnpm --filter \"@expresso/backend^...\" build && cross-env EXPRESSO_LOAD_TEST=1 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@anthropic-ai/sdk": "^1.3.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/server-util": "0.56.0",
    "@expresso/contracts": "workspace:*",
    "@expresso/editor": "workspace:*",
    "@expresso/portfolio-renderer": "workspace:*",
    "@fastify/websocket": "11.3.0",
    "bullmq": "^6.0.9",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "mongodb": "7.5.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "ws": "^8.21.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expresso/database": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "cross-env": "10.1.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
