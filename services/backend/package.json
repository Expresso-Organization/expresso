{
  "name": "@expresso/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @expresso/contracts build && pnpm --filter @expresso/database build && vitest run",
    "test:infra": "pnpm --filter @expresso/contracts build && pnpm --filter @expresso/database build && vitest run integration.test.ts",
    "test:load": "pnpm --filter @expresso/contracts build && pnpm --filter @expresso/database build && cross-env EXPRESSO_LOAD_TEST=1 vitest run"
  },
  "dependencies": {
    "@expresso/contracts": "workspace:*",
    "bullmq": "^6.0.9",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "mongodb": "7.5.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expresso/database": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "cross-env": "10.1.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
