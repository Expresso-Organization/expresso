NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# ── Google 로그인 ──
#
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 2.0 클라이언트 ID"(웹 애플리케이션)를 만들어 채운다.
#
# **승인된 리디렉션 URI**에 아래를 글자 그대로 등록해야 한다. Google은 이 값을
# 문자열로 비교한다 — 슬래시 하나만 달라도 거절한다.
#   http://localhost:3000/api/auth/google/callback
#
# 둘 중 하나라도 비면 로그인·회원가입 화면의 Google 버튼이 열리지 않는다.
# 눌러도 되돌아올 뿐인 버튼은 켜 두지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 리디렉션 주소를 만드는 기준. Google에 등록한 것과 같아야 한다.
# 앞단이 nginx라 요청 헤더에서 추측하지 않고 이 값에서만 만든다.
APP_BASE_URL=http://localhost:3000

# 개발용 세션 발급. 셋이 모두 있을 때만 /api/dev/session 이 응답하고, 로그인
# 화면 오른쪽 아래에 '개발 계정으로 접속' 버튼이 선다. 계정이 없으면 첫 호출에서
# 이 값으로 한 번 가입하고, 그 뒤로는 평범한 로그인이다.
#
# NODE_ENV를 보지 않는다 — 배포된 주소에서도 화면을 확인할 수 있어야 해서
# 프로덕션 차단을 거뒀다. 그래서 이 스위치가 유일한 안전장치다. 켜 둔 서버에서는
# 로그인 화면을 여는 누구나 그 버튼을 누르므로, 공개돼도 괜찮은 계정만 적는다.
#
# 세션이 없는 요청을 로그인 화면 대신 바로 이 문으로 보내는 전환은 개발 서버에서만
# 한다. 배포본에서는 버튼을 누른 사람만 들어간다.
DEV_LOGIN=
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
DEV_LOGIN_NAME=
