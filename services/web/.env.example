NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# ── Google 로그인 ──
#
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 2.0 클라이언트 ID"(웹 애플리케이션)를 만들어 채운다.
#
# **승인된 리디렉션 URI**에 아래를 글자 그대로 등록해야 한다. Google은 이 값을
# 문자열로 비교한다 — 슬래시 하나만 달라도 거절한다.
#   http://localhost:3000/api/auth/google/callback
#
# 둘 중 하나라도 비면 로그인·회원가입 화면의 Google 버튼이 열리지 않는다.
# 눌러도 되돌아올 뿐인 버튼은 켜 두지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 리디렉션 주소를 만드는 기준. Google에 등록한 것과 같아야 한다.
# 앞단이 nginx라 요청 헤더에서 추측하지 않고 이 값에서만 만든다.
APP_BASE_URL=http://localhost:3000
