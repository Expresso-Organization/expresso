# 운영 준비 전용입니다. 포트·데이터베이스·런타임 URI는 서버 확인 후 직접 채웁니다.
# 이 파일을 셸로 source하지 않습니다. systemd EnvironmentFile로만 읽습니다.
# 서버 설치본은 root 소유 0600, 서비스 계정은 별도의 비관리자 계정을 권장합니다.
SPRING_PROFILES_ACTIVE=operations
SPRING_BIND_ADDRESS=127.0.0.1
SPRING_PORT=
MONGODB_URL=
MONGODB_DATABASE=
MONGODB_REPLICA_SET=rs0

# 기본 비활성입니다. PR-B2 활성화 순서와 검증은 docs/operations/CAREER_WRITER_CUTOVER.md를 따릅니다.
CAREER_WRITER_ENABLED=false
CAREER_INTEGRATION_ENABLED=false
CAREER_PROPERTY_MUTATION_ENABLED=false
CAREER_WRITER_MOVE_SECRET=
CAREER_INTEGRATION_AI_SECRET=
CAREER_INTEGRATION_INTERVIEW_SECRET=
CAREER_PRODUCT_SERVICE_SECRET=
CAREER_PROPERTY_MUTATION_SECRET=

# 마이그레이션 URI·Web 세션·외부 AI 키를 이 런타임에 넣지 않습니다.
