flowchart TD
  SEND[입력창 · 제안 동작] --> OPEN[HomeHandoff.open]
  OPEN --> PEND[대기 중 내용 옅게]
  OPEN --> NAV[router.push<br/>agent-chat-open]
  NAV --> VT[View Transition]
  VT --> LEAVE[홈 빠짐 160ms]
  VT --> MORPH[입력창 짝 280ms]
  VT --> ARRIVE[대화 화면 220ms]
  OPEN --> MEM[agent-handoff 메모리]
  MEM --> BUBBLE[첫 렌더 말풍선 떠오름]
  BUBBLE --> HOLD[보낼 수 없으면 거둠]
  ROOT[다른 이동 교차 끔] --> VT
  PR{PR 머지 D5} --> DEPLOY[운영 배포]
  classDef done fill:#d1fae5,stroke:#059669
  classDef doing fill:#fef3c7,stroke:#d97706
  classDef decide fill:#fee2e2,stroke:#dc2626
  classDef todo fill:#f3f4f6,stroke:#9ca3af,stroke-dasharray:4
  class SEND,OPEN,PEND,NAV,VT,LEAVE,MORPH,ARRIVE,MEM,BUBBLE,HOLD,ROOT done
  class PR decide
  class DEPLOY todo
