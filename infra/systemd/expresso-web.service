[Unit]
Description=Expresso Web
After=network-online.target expresso-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/expresso/services/web
ExecStart=/home/ubuntu/.nvm/versions/node/v24.13.1/bin/node node_modules/next/dist/bin/next start --port 3500
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
# 브라우저가 부르는 주소다. 서버 컴포넌트도 같은 값을 쓴다(앞단 nginx를 지난다).
Environment=NEXT_PUBLIC_API_BASE_URL=https://expresso.ai.kr
Restart=always
RestartSec=3
StandardOutput=append:/home/ubuntu/expresso/log/web.log
StandardError=append:/home/ubuntu/expresso/log/web.log

[Install]
WantedBy=multi-user.target
