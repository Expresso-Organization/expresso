[Unit]
Description=Expresso local recommendation inference
After=local-fs.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/expresso
StateDirectory=expresso-match
StateDirectoryMode=0700
UMask=0077
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
CPUQuota=100%
ExecStart=/home/ubuntu/expresso/var/match-venv/bin/python services/match-inference/server.py --bundle var/match-release/cpu --threads 1 --vector-dir /var/lib/expresso-match
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
