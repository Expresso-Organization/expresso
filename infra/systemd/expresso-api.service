[Unit]
Description=Expresso API
# 인프라는 compose가 쥐고 있다. 도커가 뜬 뒤에 시작한다.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/expresso/services/backend
# 셸을 거치지 않으므로 nvm에 기대지 않는다. 이 기계의 기본 Node는 22다.
ExecStart=/home/ubuntu/.nvm/versions/node/v24.13.1/bin/node dist/api/main.js
EnvironmentFile=/home/ubuntu/expresso/services/backend/.env
Restart=always
# 종료 신호(SIGTERM)는 node에만 보낸다. 에이전트 채팅의 Claude Code 자식 프로세스는 node가
# abort로 정리하고 대화를 「중단」으로 남긴다. control-group이면 자식이 같은 순간 신호를 받아
# 먼저 죽고, 실행이 「실패」로 기록된다. node가 끝나면 남은 프로세스는 SIGKILL을 받는다.
KillMode=mixed
RestartSec=3
StandardOutput=append:/home/ubuntu/expresso/log/api.log
StandardError=append:/home/ubuntu/expresso/log/api.log

[Install]
WantedBy=multi-user.target
