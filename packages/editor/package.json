{
  "name": "@expresso/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "default": "./dist/commands.js"
    },
    "./document": {
      "types": "./src/document.ts",
      "default": "./dist/document.js"
    },
    "./yjs": {
      "types": "./src/yjs.ts",
      "default": "./dist/yjs.js"
    },
    "./blocknote": {
      "types": "./src/blocknote.ts",
      "default": "./dist/blocknote.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blocknote/core": "0.56.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
