        },
        "planJson": {
          "bsonType": "string",
          "minLength": 2,
          "maxLength": 2097152
        },
        "operationFingerprint": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "bsonType": "string",
          "enum": [
            "pending",
            "running",
            "failed",
            "completed"
          ]
        },
        "active": {
          "bsonType": "bool"
        },
        "cursor": {
          "bsonType": [
            "int",
            "long",
            "double"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1
        },
        "processedCount": {
          "bsonType": [
            "int",
            "long",
            "double"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1
        },
        "skippedCount": {
          "bsonType": [
            "int",
            "long",
            "double"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1
        },
        "attempts": {
          "bsonType": [
            "int",
            "long",
            "double"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1
        },
        "leaseToken": {
          "bsonType": [
            "string",
            "null"
          ]
        },
        "leaseUntil": {
          "bsonType": [
            "date",
            "null"
          ]
        },
        "lastError": {
          "bsonType": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "createdAt": {
          "bsonType": "date"
        },
        "updatedAt": {
          "bsonType": "date"
        },
        "completedAt": {
          "bsonType": [
            "date",
            "null"
          ]
        },
        "commitFence": {
          "bsonType": [
            "int",
            "long",
            "double"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1
        }
      }
    }
  },
