{
  "name": "expresso",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "build:portfolio-css": "node scripts/build-portfolio-css.mjs",
    "check:portfolio-css": "node scripts/build-portfolio-css.mjs --check",
    "db:migrate": "pnpm --filter @expresso/database migrate",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:ready": "docker compose -f infra/compose.yaml ps --format json",
    "test:infra": "TEST_DATABASE_URL=mysql://expresso:expresso@127.0.0.1:53306/expresso TEST_REDIS_URL=redis://127.0.0.1:56379 pnpm --filter @expresso/backend test:infra",
    "dev:backend": "pnpm --filter @expresso/backend dev",
    "dev:worker": "pnpm --filter @expresso/backend dev:worker",
    "dev:web": "pnpm --filter @expresso/web dev"
  }
}
